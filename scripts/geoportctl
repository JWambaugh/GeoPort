#!/usr/bin/env bash
# Talk to a GeoPort server on this machine. Stdlib curl only.
#   GEOPORT_URL=http://127.0.0.1:54321 ./scripts/geoportctl status
set -euo pipefail
BASE="${GEOPORT_URL:-http://127.0.0.1:54321}"
cmd="${1:-status}"
if [[ $# -gt 0 ]]; then
  shift
fi

die() { echo "geoportctl: $*" >&2; exit 1; }

json_post() {
  local path="$1"
  local data="$2"
  curl -sS -H 'Content-Type: application/json' -d "$data" "${BASE}${path}"
}

need() {
  local name="$1"
  local value="${2:-}"
  [[ -n "$value" ]] || die "missing $name"
}

case "$cmd" in
  status)
    curl -sS "${BASE}/api/v1/status"
    echo
    ;;
  geocode)
    q="${1:-}"
    need "an address" "$q"
    curl -sS -G "${BASE}/api/v1/geocode" --data-urlencode "q=${q}"
    echo
    ;;
  teleport)
    lat="" lng="" address=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lat) lat="$2"; shift 2 ;;
        --lng) lng="$2"; shift 2 ;;
        --address) address="$2"; shift 2 ;;
        *) die "unknown teleport option: $1" ;;
      esac
    done
    if [[ -n "$address" ]]; then
      json_post /api/v1/teleport "$(printf '{"address":"%s"}' "$address")"
    else
      need "--lat" "$lat"
      need "--lng" "$lng"
      json_post /api/v1/teleport "$(printf '{"lat":%s,"lng":%s}' "$lat" "$lng")"
    fi
    echo
    ;;
  drive)
    lat="" lng="" address="" fromlat="" fromlng="" offset="0" accuracy="" start="true" stops="true"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --to) address="$2"; shift 2 ;;
        --to-lat) lat="$2"; shift 2 ;;
        --to-lng) lng="$2"; shift 2 ;;
        --from-lat) fromlat="$2"; shift 2 ;;
        --from-lng) fromlng="$2"; shift 2 ;;
        --offset) offset="$2"; shift 2 ;;
        --accuracy) accuracy="$2"; shift 2 ;;
        --no-start) start="false"; shift ;;
        --no-stops) stops="false"; shift ;;
        *) die "unknown drive option: $1" ;;
      esac
    done
    if [[ -n "$address" ]]; then
      to="$(printf '{"address":"%s"}' "$address")"
    else
      need "--to-lat or --to" "$lat"
      need "--to-lng" "$lng"
      to="$(printf '{"lat":%s,"lng":%s}' "$lat" "$lng")"
    fi
    from="null"
    if [[ -n "$fromlat" || -n "$fromlng" ]]; then
      need "--from-lat" "$fromlat"
      need "--from-lng" "$fromlng"
      from="$(printf '{"lat":%s,"lng":%s}' "$fromlat" "$fromlng")"
    fi
    acc="null"
    if [[ -n "$accuracy" ]]; then acc="$accuracy"; fi
    json_post /api/v1/drive "$(printf '{"to":%s,"from":%s,"speed_offset_pct":%s,"accuracy_m":%s,"start":%s,"stops":%s}' "$to" "$from" "$offset" "$acc" "$start" "$stops")"
    echo
    ;;
  connect)
    json_post /api/v1/connect '{}'
    echo
    ;;
  start|pause|resume|stop)
    json_post "/api/v1/drive/${cmd}" '{}'
    echo
    ;;
  accuracy)
    if [[ $# -eq 0 ]]; then
      curl -sS "${BASE}/api/v1/accuracy"
    else
      json_post /api/v1/accuracy "$(printf '{"meters":%s}' "$1")"
    fi
    echo
    ;;
  devices|list)
    curl -sS "${BASE}/api/v1/devices"
    echo
    ;;
  clear)
    json_post /api/v1/clear '{}'
    echo
    ;;
  trip)
    action="${1:-}"
    case "$action" in
      ""|status)
        curl -sS "${BASE}/api/v1/trip"
        echo
        ;;
      pause|resume|skip|stop)
        json_post "/api/v1/trip/${action}" '{}'
        echo
        ;;
      library)
        curl -sS "${BASE}/api/v1/trip/library"
        echo
        ;;
      edit)
        ref="${2:-}"
        need "a stop number or id" "$ref"
        shift 2
        payload="$(python3 - "$ref" "$@" <<'PY'
import json, sys
args = sys.argv[2:]
patch = {}
i = 0
while i < len(args):
    arg = args[i]
    if arg == "--dwell":
        patch["dwell_minutes"] = float(args[i + 1])
        i += 2
    elif arg == "--to":
        patch["to"] = args[i + 1]
        i += 2
    elif arg == "--mode":
        patch["mode"] = args[i + 1]
        i += 2
    elif arg == "--label":
        patch["label"] = args[i + 1]
        i += 2
    elif arg == "--lat":
        patch["lat"] = float(args[i + 1])
        i += 2
    elif arg == "--lng":
        patch["lng"] = float(args[i + 1])
        i += 2
    elif arg == "--inside":
        patch["go_inside"] = True
        i += 1
    elif arg == "--park":
        patch["go_inside"] = False
        i += 1
    elif arg in ("--pass", "--waypoint"):
        patch["waypoint"] = True
        i += 1
    elif arg == "--up":
        patch["move"] = "up"
        i += 1
    elif arg == "--down":
        patch["move"] = "down"
        i += 1
    elif arg == "--delete":
        patch["delete"] = True
        i += 1
    elif arg == "--direct":
        patch["direct"] = True
        patch["route"] = "straight"
        i += 1
    elif arg == "--path":
        patch["direct"] = False
        patch["route"] = "path"
        i += 1
    elif arg == "--still":
        patch["dwell_mode"] = "still"
        patch["wander"] = False
        i += 1
    elif arg == "--wander":
        patch["dwell_mode"] = "wander"
        patch["wander_mps"] = float(args[i + 1])
        i += 2
    elif arg == "--radius":
        patch["wander_radius_m"] = float(args[i + 1])
        i += 2
    else:
        raise SystemExit("geoportctl: unknown edit option: " + arg)
if not patch:
    raise SystemExit("geoportctl: nothing to change")
print(json.dumps(patch))
PY
)"
        curl -sS -X PATCH -H 'Content-Type: application/json' -d "$payload" "${BASE}/api/v1/trip/stops/${ref}"
        echo
        ;;
      save)
        name="${2:-}"
        need "a name" "$name"
        payload="$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1]}))' "$name")"
        json_post /api/v1/trip/library "$payload"
        echo
        ;;
      load)
        name="${2:-}"
        need "a name" "$name"
        start=false
        if [[ "${3:-}" == "--start" ]]; then start=true; fi
        payload="$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1], "start": sys.argv[2]=="true"}))' "$name" "$start")"
        json_post /api/v1/trip/library/load "$payload"
        echo
        ;;
      --stop|--walk|--walk-direct|--pin|--file|--park|--outside|--no-start|--no-stops|--offset|--walk-speed|--from|--wander|--radius|--still|--direct|--path)
        payload="$(python3 - "$@" <<'PY'
import json, re, sys
args = sys.argv[1:]
coord = re.compile(r"^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$")
stops = []
start = True
include_stops = True
offset = 0
walk_speed = None
origin = None
park_next = False
file_path = None
pending = {}

def place(text):
    match = coord.match(text.strip())
    if match:
        return {"lat": float(match.group(1)), "lng": float(match.group(2))}
    return {"address": text}

i = 0
while i < len(args):
    arg = args[i]
    if arg == "--file":
        file_path = args[i + 1]
        i += 2
        continue
    if arg == "--no-start":
        start = False
        i += 1
        continue
    if arg == "--no-stops":
        include_stops = False
        i += 1
        continue
    if arg == "--offset":
        offset = float(args[i + 1])
        i += 2
        continue
    if arg == "--walk-speed":
        walk_speed = float(args[i + 1])
        i += 2
        continue
    if arg == "--from":
        origin = place(args[i + 1])
        i += 2
        continue
    if arg in ("--park", "--outside"):
        park_next = True
        i += 1
        continue
    if arg == "--still":
        pending["dwell_mode"] = "still"
        pending["wander"] = False
        i += 1
        continue
    if arg == "--wander":
        pending["dwell_mode"] = "wander"
        pending["wander_mps"] = float(args[i + 1])
        i += 2
        continue
    if arg == "--radius":
        pending["wander_radius_m"] = float(args[i + 1])
        i += 2
        continue
    if arg == "--direct":
        pending["direct"] = True
        pending["route"] = "straight"
        i += 1
        continue
    if arg == "--path":
        pending["direct"] = False
        pending["route"] = "path"
        i += 1
        continue
    if arg in ("--stop", "--walk", "--walk-direct", "--pin"):
        text = args[i + 1]
        minutes = float(args[i + 2])
        i += 3
        mode = "walk" if arg in ("--walk", "--walk-direct", "--pin") else "drive"
        if i < len(args) and args[i] in ("walk", "drive"):
            mode = args[i]
            i += 1
        item = place(text)
        item.update(pending)
        pending = {}
        item["dwell_minutes"] = minutes
        item["mode"] = mode
        item["go_inside"] = mode == "drive" and not park_next
        item["waypoint"] = (arg == "--pin" and minutes == 0) or (arg in ("--walk", "--walk-direct") and minutes == 0)
        if arg == "--walk-direct":
            item["direct"] = True
            item["route"] = "straight"
        park_next = False
        stops.append(item)
        continue
    raise SystemExit("geoportctl: unknown trip option: " + arg)

if pending and stops:
    stops[-1].update(pending)

if file_path:
    with open(file_path, encoding="utf-8") as handle:
        payload = json.load(handle)
    if isinstance(payload, list):
        payload = {"stops": payload}
    if not start:
        payload["start"] = False
    else:
        payload.setdefault("start", True)
    if not include_stops:
        payload["include_stops"] = False
    if offset:
        payload["speed_offset_pct"] = offset
    if walk_speed is not None:
        payload["walk_speed_mps"] = walk_speed
    if origin is not None:
        payload["from"] = origin
    if stops:
        payload["stops"] = list(payload.get("stops") or []) + stops
else:
    if not stops:
        raise SystemExit("geoportctl: add at least one --stop, --walk, --walk-direct, or --pin")
    payload = {
        "stops": stops,
        "start": start,
        "include_stops": include_stops,
        "speed_offset_pct": offset,
    }
    if walk_speed is not None:
        payload["walk_speed_mps"] = walk_speed
    if origin is not None:
        payload["from"] = origin
print(json.dumps(payload))
PY
)"
        json_post /api/v1/trip "$payload"
        echo
        ;;
      *)
        die "unknown trip command: $action (try geoportctl help)"
        ;;
    esac
    ;;
  help|-h|--help)
    cat <<'EOF'
geoportctl — local GeoPort automation (curl to localhost)

  GEOPORT_URL   default http://127.0.0.1:54321

  geoportctl status
  geoportctl geocode "Queen Street, Brisbane"
  geoportctl teleport --lat -27.47 --lng 153.026
  geoportctl teleport --address "Brisbane CBD"
  geoportctl drive --to "South Bank, Brisbane" [--offset 10] [--accuracy 20] [--no-start] [--no-stops]
  geoportctl drive --to-lat -27.48 --to-lng 153.03 [--from-lat LAT --from-lng LNG]
  geoportctl connect
  geoportctl start | pause | resume | stop
  geoportctl accuracy [meters]
  geoportctl devices
  geoportctl clear
  geoportctl trip --stop "Target, Grass Valley" 20 --stop "Costco, Grass Valley" 40
  geoportctl trip --stop "Target" 20 --walk "39.21,-121.06" 5 --pin 39.22,-121.07 0 --stop "Costco" 40
  geoportctl trip --file trip.json [--no-start] [--no-stops] [--offset 10] [--walk-speed 1.3]
  geoportctl trip status | pause | resume | skip | stop
  geoportctl trip save NAME | load NAME [--start] | library
  geoportctl trip --walk-direct "39.22,-121.07" 5 --wander 0.6 --radius 25
  geoportctl trip edit N --dwell 30 --to "Costco" --mode walk
  geoportctl trip edit N --wander 0.6 --radius 25 | --still | --direct | --path
  geoportctl trip edit N --label NAME --inside|--park|--pass --up|--down|--delete
EOF
    ;;
  *)
    die "unknown command: $cmd (try geoportctl help)"
    ;;
esac
